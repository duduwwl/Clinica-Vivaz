# Copie para .env.local e preencha. Nunca coloque a service_role key aqui:
# tudo que começa com VITE_ vai para o navegador.

# Projeto Supabase (Settings → API). Sem estas duas, o site roda em MODO DEMONSTRAÇÃO.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-publica

# Endereço público do site (canonical, sitemap, Open Graph)
VITE_SITE_URL=https://duduwwl.github.io/Clinica-Vivaz

# Caminho base. GitHub Pages do projeto: /Clinica-Vivaz/  · domínio próprio: /
VITE_BASE=/Clinica-Vivaz/

# ---------------------------------------------------------------------------
# Somente na Edge Function de notificações (Supabase → Edge Functions → Secrets).
# NÃO use no front-end.
# WHATSAPP_TOKEN=token-permanente-da-meta
# WHATSAPP_PHONE_NUMBER_ID=id-do-numero-no-whatsapp-business
# WHATSAPP_TEMPLATE_LANG=pt_BR
# CRON_SECRET=um-segredo-longo-para-chamar-a-funcao
